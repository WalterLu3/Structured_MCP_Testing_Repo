         ,e11079.u11079,e11080.u11080,e11081.u11081,e11082.u11082
         ,e11083.u11083,e11084.u11084,e11085.u11085,e11086.u11086 /;

m.limrow=0; m.limcol=0;

* Regenerate this instance's polyhedral row information before solving.
File linlibPolyFile / 'poly.txt' /;
linlibPolyFile.pc = 2;
