         ,e897.u897,e898.u898,e899.u899,e900.u900,e901.u901,e902.u902
         ,e903.u903,e904.u904,e905.u905,e906.u906,e907.u907,e908.u908
         ,e909.u909,e910.u910,e911.u911,e912.u912,e913.u913,e914.u914
         ,e915.u915,e916.u916 /;

m.limrow=0; m.limcol=0;

* Regenerate this instance's polyhedral row information before solving.
File linlibPolyFile / 'poly.txt' /;
linlibPolyFile.pc = 2;
Scalar linlibPolyRow;
put linlibPolyFile;
for (linlibPolyRow = 605 to 916,
    put 'e' linlibPolyRow:0:0 /;
);
putclose linlibPolyFile '';

Solve m using MCP;
